# Hyaena Storage — uygulama ayarları (.env)
# ADIM 1: ADMIN_PASSWORD'u değiştir (zorunlu). Diğerleri isteğe bağlı.

# --- Admin ---
# ZORUNLU: güçlü, benzersiz bir şifre gir (boş/varsayılan = servis açılmaz)
ADMIN_PASSWORD=
# Boş bırakılırsa paroladan türetilir; istersen ayrı sabit belirle:
ADMIN_TOKEN_SECRET=

# --- Telegram ---
# config.ini yerine env ile de verilebilir (container/VPS için pratik):
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# İki doğrulamalı login (isteğe bağlı)
TELEGRAM_TWO_FA=
# Oturum dosyasının yolu (varsayılan: session)
SESSION_FILE=session

# --- Dosya / segment ---
# Segment boyutu (byte). 20 MB = 20971520
SEGMENT_BYTES=20971520
# Tek dosya üst sınırı (byte). 100 GB = 107374182400
MAX_UPLOAD_BYTES=107374182400
# Eşzamanlı indirme üst sınırı (ilk parça bellekte tutulur, RAM koruması)
MAX_CONCURRENT_DOWNLOADS=16

# --- Kanal filosu ---
# İlk kurulumda (hiç kanal yokken) açılacak kanal sayısı — bootstrap.
# Filo kurulduktan sonra hedefe tamamlama YOKTUR; kanal sayısı mevcut
# hâline peg'lenir ve her gün +1 kanal ile organik büyür.
BOOTSTRAP_CHANNELS=1
# Kanal oluşturma arası bekleme (saniye) — flood koruması
CHANNEL_INTERVAL_SN=90

# --- Servis ---
HOST=0.0.0.0
PORT=8080
# Per-IP dakikalık istek sınırı (upload/download). Doğrudan bağlantılarda
# RemoteAddr, Cloudflare üzerinden gelenlerde CF-Connecting-IP esas alınır.
RATE_LIMIT_PER_MIN=20
# Postgres (Supabase) bağlantısı — Dashboard → Connect → Pooler URL
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
TMP_ROOT=data/tmp

# --- Paylaşım link tabanları ---
# Küçük dosyalar Cloudflare cache'li tabandan, büyükler Cloudflare'sız
# doğrudan sunucudan servis edilir (CF büyük stream'leri kesiyor).
PUBLIC_BASE_URL=
DIRECT_BASE_URL=
# Bu boyutun ÜZERİNDEKİ dosyalar direct tabandan servis edilir (480 MB)
DIRECT_THRESHOLD_BYTES=503316480

# --- Cloudflare (dosya silinince edge cache purge) ---
CF_ZONE_ID=
CF_API_EMAIL=
CF_API_KEY=

# --- Northflank metrics (egress izleme; origin VPS'te opsiyonel) ---
NORTHFLANK_TOKEN=
NORTHFLANK_PROJECT=hyaena
NORTHFLANK_SERVICE=hyaena-storage
